# Cadastre as variáveis secretas no projeto Vercel; não use NEXT_PUBLIC_ para a chave.

# Provedor de Pix: "demo" (padrão) ou "flevopag" para cobrar pela API.
PIX_PROVIDER=demo
FLEVOPAG_API_KEY=
FLEVOPAG_API_URL=https://app.flevopay.com.br

# Webhook opcional: só é enviado quando ambos abaixo estão definidos.
PUBLIC_BASE_URL=https://checkout001.vercel.app
PIX_WEBHOOK_SECRET=
